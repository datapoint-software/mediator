<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>A Datapoint.Mediator behaviour that validates commands and queries with FluentValidation before their handler runs.</Description>
    <PackageTags>$(PackageTags);fluentvalidation;validation</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Datapoint.Mediator.Abstractions\Datapoint.Mediator.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation" />
  </ItemGroup>

  <!-- Shared with the other packages as source: see src/Shared. -->
  <ItemGroup>
    <Compile Include="..\Shared\Services.cs" Link="Shared\Services.cs" />
  </ItemGroup>

</Project>
