<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Registers the Datapoint.Mediator authorization behaviour and authorizers with Microsoft.Extensions.DependencyInjection.</Description>
    <PackageTags>$(PackageTags);authorization;security</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Datapoint.Mediator.Authorization\Datapoint.Mediator.Authorization.csproj" />
    <ProjectReference Include="..\Datapoint.Mediator.DependencyInjection\Datapoint.Mediator.DependencyInjection.csproj" />
  </ItemGroup>

  <!-- Shared with the other packages as source: see src/Shared. -->
  <ItemGroup>
    <Compile Include="..\Shared\AnonymousAccess.cs" Link="Shared\AnonymousAccess.cs" />
    <Compile Include="..\Shared\AssemblyTypes.cs" Link="Shared\AssemblyTypes.cs" />
    <Compile Include="..\Shared\PrincipalAccessorRegistration.cs" Link="Shared\PrincipalAccessorRegistration.cs" />
  </ItemGroup>

</Project>
