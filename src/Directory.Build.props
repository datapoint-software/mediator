<Project>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <Authors>Datapoint - Sistemas de Informação, Lda.</Authors>
    <Company>Datapoint - Sistemas de Informação, Lda.</Company>
    <Copyright>Copyright (c) 2026 Datapoint - Sistemas de Informação, Lda.</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageTags>mediator;cqrs;commands;queries;messages</PackageTags>
  </PropertyGroup>

  <!-- Source Link and symbols, so consumers can step into the source while debugging. -->
  <PropertyGroup>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <!-- Rendered at 256×256 from the favicon at https://datapoint.software/, because NuGet only accepts PNG or JPEG. -->
    <None Include="$(MSBuildThisFileDirectory)icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <!-- Versions come from git tags without a prefix, such as 4.0.0-alpha.1. -->
  <PropertyGroup>
    <MinVerMinimumMajorMinor>4.0</MinVerMinimumMajorMinor>
    <MinVerDefaultPreReleaseIdentifiers>alpha.0</MinVerDefaultPreReleaseIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MinVer" PrivateAssets="all" />
  </ItemGroup>

  <!--
    Fails the build when the public API changes without PublicAPI.*.txt being updated.
    RS0026 is disabled because overloads that each end in an optional CancellationToken are the .NET convention.
  -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);RS0026</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>

  <!--
    Fails the pack when a package is not binary compatible with its baseline.
    Betas may break the API, so there is no baseline yet. After 4.0.0-rc.1 is published, set
    PackageValidationBaselineVersion to 4.0.0-rc.1 here, and to 4.0.0 once 4.0.0 is published (ADR 0036).
    Clear it in the .csproj of any package first released later.
  -->
  <PropertyGroup>
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>

  <!-- The repository URL is only known once Source Link has read the git remote. -->
  <Target Name="SetPackageProjectUrl" BeforeTargets="GenerateNuspec" DependsOnTargets="InitializeSourceControlInformation">
    <PropertyGroup>
      <PackageProjectUrl Condition="'$(PackageProjectUrl)' == ''">$([System.Text.RegularExpressions.Regex]::Replace('$(RepositoryUrl)', '\.git$', ''))</PackageProjectUrl>
    </PropertyGroup>
  </Target>

</Project>
