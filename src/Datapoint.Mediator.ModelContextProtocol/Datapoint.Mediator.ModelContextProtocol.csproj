<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Offers Datapoint.Mediator actions as Model Context Protocol (MCP) tools, so AI agents can call your commands and queries with authorization, validation and transactions applied.</Description>
    <PackageTags>$(PackageTags);mcp;model-context-protocol;ai;agents</PackageTags>
  </PropertyGroup>

  <!-- Shared with the other host adapters as source: see src/Shared. -->
  <ItemGroup>
    <Compile Include="..\Shared\AdapterErrors.cs" Link="Shared\AdapterErrors.cs" />
    <Compile Include="..\Shared\AdapterMessages.cs" Link="Shared\AdapterMessages.cs" />
    <Compile Include="..\Shared\HostProvidedNames.cs" Link="Shared\HostProvidedNames.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Datapoint.Mediator.Abstractions\Datapoint.Mediator.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" />
  </ItemGroup>

</Project>
