<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>A Datapoint.Mediator behaviour that authorizes commands and queries for the current user, denying access by default, so the same rules apply from an API, a CLI or an MCP server.</Description>
    <PackageTags>$(PackageTags);authorization;security</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Datapoint.Mediator.Abstractions\Datapoint.Mediator.Abstractions.csproj" />
  </ItemGroup>

  <!-- Shared with the other packages as source: see src/Shared. -->
  <ItemGroup>
    <Compile Include="..\Shared\AnonymousAccess.cs" Link="Shared\AnonymousAccess.cs" />
    <Compile Include="..\Shared\Services.cs" Link="Shared\Services.cs" />
  </ItemGroup>

</Project>
